# Необязательно: с ключом резюме и перевод делает Claude (качество выше).
# Без ключа работают встроенное резюме и собственный сервис перевода LibreTranslate (docker compose).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Максимальный размер файла для серверных инструментов, МБ
MAX_UPLOAD_MB=50
# Сколько серверных конвертаций выполняется одновременно
MAX_CONCURRENT_JOBS=2
# Адрес сайта (sitemap, мета-теги)
NEXT_PUBLIC_SITE_URL=https://pdfhub.ru
# Секрет для подписи сессий (если пусто — создаётся data/secret.key)
AUTH_SECRET=
# Папка для users.json и messages.jsonl
DATA_DIR=./data
# Необязательно: дублировать сообщения из формы «Контакты» на этот URL
CONTACT_WEBHOOK_URL=
# Лимит ИИ-запросов с одного IP в час
AI_REQUESTS_PER_HOUR=120
# Домен для HTTPS (Caddy)
DOMAIN=pdfhub.ru
# Адрес LibreTranslate (в docker compose уже задан)
# необязательно: свой LibreTranslate (иначе используются бесплатные сервисы)
LIBRETRANSLATE_URL=http://libretranslate:5000
# Максимальный размер видео/аудио, МБ
MAX_MEDIA_MB=300

# SEO: коды подтверждения владения сайтом (Google Search Console / Яндекс.Вебмастер)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
